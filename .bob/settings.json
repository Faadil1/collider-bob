{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m collider.bob_hook session-start",
            "timeout": 8
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -m collider.bob_hook stop",
            "timeout": 8
          }
        ]
      }
    ]
  }
}
