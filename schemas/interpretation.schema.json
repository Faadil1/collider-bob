{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Collider Interpretation",
  "type": "object",
  "required": ["agent_id", "workstream", "claims"],
  "properties": {
    "agent_id": {"type": "string"},
    "workstream": {"type": "string"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["concept", "value", "epistemic_state", "evidence_refs", "consumed_by"],
        "properties": {
          "concept": {"type": "string"},
          "value": {},
          "epistemic_state": {"enum": ["OBSERVED", "INFERRED", "UNKNOWN"]},
          "evidence_refs": {"type": "array", "items": {"type": "string"}},
          "consumed_by": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}